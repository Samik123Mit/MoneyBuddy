# MoneyBuddy Backend Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production
MONEYBUDDY_ENVIRONMENT=development

# =============================================================================
# Database Configuration
# =============================================================================
# For development (SQLite):
MONEYBUDDY_DATABASE_URL=sqlite:///./moneybuddy.db

# For production (Neon PostgreSQL via Vercel integration):
# MONEYBUDDY_DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Enable SQL query logging (disable in production)
MONEYBUDDY_DATABASE_ECHO=false

# =============================================================================
# JWT Authentication (CRITICAL - Change for production!)
# =============================================================================
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: The default value is for development only!
MONEYBUDDY_JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long

# Token expiration settings (defaults: 30 min access, 7 day refresh)
# MONEYBUDDY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# MONEYBUDDY_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OAuth (at least one provider required for login)
# =============================================================================
# Google: https://console.cloud.google.com/apis/credentials
# MONEYBUDDY_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# MONEYBUDDY_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub: https://github.com/settings/developers
# MONEYBUDDY_GITHUB_CLIENT_ID=your-github-client-id
# MONEYBUDDY_GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL for OAuth redirect callbacks
# MONEYBUDDY_FRONTEND_URL=http://localhost:5173

# =============================================================================
# Logging Configuration
# =============================================================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
MONEYBUDDY_LOG_LEVEL=INFO

# =============================================================================
# Data Directory
# =============================================================================
# For temporary files and exports
MONEYBUDDY_DATA_DIR=./data
