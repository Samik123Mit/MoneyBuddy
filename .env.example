# MoneyBuddy environment template.
# Copy MONEYBUDDY_* variables to backend/.env for local backend development.
# Copy VITE_* variables to frontend/.env.local for local frontend development.
# Never put real secrets in this file.

# Backend runtime
MONEYBUDDY_ENVIRONMENT=development
MONEYBUDDY_DATABASE_URL=sqlite:///./moneybuddy.db
MONEYBUDDY_DATABASE_ECHO=false
MONEYBUDDY_LOG_LEVEL=INFO
MONEYBUDDY_DATA_DIR=./data
MONEYBUDDY_FRONTEND_URL=http://localhost:5173
MONEYBUDDY_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]

# Auth and encryption
# Required in production. Use a random value of at least 32 characters.
MONEYBUDDY_JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
MONEYBUDDY_ENCRYPTION_KEY=change-me-to-a-separate-random-string-at-least-32-chars
MONEYBUDDY_JWT_ALGORITHM=HS256
MONEYBUDDY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
MONEYBUDDY_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MONEYBUDDY_JWT_STRICT_TV=false

# OAuth providers
MONEYBUDDY_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
MONEYBUDDY_GOOGLE_CLIENT_SECRET=your-google-client-secret
MONEYBUDDY_GITHUB_CLIENT_ID=your-github-client-id
MONEYBUDDY_GITHUB_CLIENT_SECRET=your-github-client-secret

# Uploads
MONEYBUDDY_MAX_UPLOAD_SIZE_BYTES=52428800

# PostgreSQL pool settings
MONEYBUDDY_DB_POOL_SIZE=5
MONEYBUDDY_DB_MAX_OVERFLOW=3
MONEYBUDDY_DB_POOL_RECYCLE_SECONDS=300
MONEYBUDDY_DB_CONNECT_TIMEOUT_SECONDS=10
MONEYBUDDY_DB_STATEMENT_TIMEOUT_SECONDS=30
MONEYBUDDY_DB_IDLE_TRANSACTION_TIMEOUT_SECONDS=60

# Frontend
# Local development uses the Vite /api proxy. Set this only for split production hosting.
# VITE_API_BASE_URL=https://your-api-host.example.com

# Deployment helpers
GITHUB_PAGES=false
PYTHON_VERSION=3.13
